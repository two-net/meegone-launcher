<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the device's dark theme. Nothing is drawn until the UI toolkit arrives
         (ADR 0002), so the home screen shows the wallpaper through a transparent window. -->
    <style name="Theme.MeeGone" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
