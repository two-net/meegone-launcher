    <string name="recent_window_12_hours">12 hours</string>
    <string name="recent_window_24_hours">24 hours</string>
    <string name="recent_window_3_days">3 days</string>

    <!-- The Home group of Settings (SET-02). -->
    <string name="settings_group_home">Home</string>
