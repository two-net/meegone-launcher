<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">MeeGone</string>

    <!-- The three home views (HOME-02). -->
    <string name="view_events">Events</string>
    <string name="view_applications">Applications</string>
    <string name="view_recent">Recent</string>
    <!-- Read by screen readers when the home view changes, e.g. "Applications, 2 of 3"
         (A11Y-08). %1$s is the view, %2$d its place from the left, %3$d how many there are. -->
    <string name="view_position">%1$s, %2$d of %3$d</string>
    <!-- Screen-reader actions that switch home views without a gesture (A11Y-05). -->
    <string name="action_next_view">Next view</string>
    <string name="action_previous_view">Previous view</string>

    <!-- The home menu, opened by a long-press on empty space in Events or Applications
         (HOME-10). Screen readers announce its title and open it with the action
         (A11Y-05). -->
    <string name="home_menu">Home menu</string>
    <string name="action_home_menu">Home menu</string>
    <string name="menu_launcher_settings">Launcher settings</string>
    <string name="menu_lock_screen_image">Lock-screen image</string>
    <string name="menu_edit_applications">Edit applications</string>

    <!-- Applications (APPS-01). A work-profile app's name for screen readers, e.g. "Mail, work"
         (A11Y-01). %1$s is the app's label. -->
    <string name="app_work">%1$s, work</string>
    <!-- The name screen readers read for an app installed since the grid was set up and not
         opened yet, which has a dot, e.g. "Maps, new" (APPS-07). %1$s is its name, with "work"
         when it has it. -->
    <string name="app_new">%1$s, new</string>
    <!-- Read by screen readers after the name of an app that can't open now: its work profile
         is paused, it is suspended or its storage is missing (APPS-09). -->
    <string name="app_state_unavailable">Unavailable</string>
    <!-- Shown briefly when a tapped app couldn't open and the system said nothing itself
         (APPS-09). -->
    <string name="app_unavailable">This app can\'t open right now</string>

    <!-- An app's long-press menu (APPS-11). Screen readers announce its title, e.g. "Mail
         menu", where %1$s is the app's name, and open it with the action (A11Y-05). Edit
         applications shares the home menu's text. -->
    <string name="app_menu">%1$s menu</string>
    <string name="action_app_menu">Open menu</string>
    <string name="menu_app_info">App info</string>
    <string name="menu_uninstall">Uninstall</string>
    <!-- Leaves the app out of Applications, search and Recent until it is unhidden in
         Settings (APPS-19). -->
    <string name="menu_hide">Hide</string>
    <!-- Shown briefly when the system refuses an item of the app menu. -->
    <string name="app_info_unavailable">App info can\'t open right now</string>
    <string name="uninstall_unavailable">This app can\'t be uninstalled right now</string>
    <string name="shortcut_unavailable">This shortcut can\'t open right now</string>

    <!-- Edit mode in Applications (APPS-12). The button that ends it. -->
    <string name="edit_done">Done</string>
    <!-- Read by screen readers when edit mode starts (A11Y-08). -->
    <string name="edit_mode">Edit mode</string>
    <!-- The name of an app's ✕ in edit mode, which asks the system to uninstall it (APPS-13,
         A11Y-01). Screen readers offer it as an action. %1$s is the app's name. -->
    <string name="action_uninstall">Uninstall %1$s</string>
    <!-- Screen-reader actions that move an app's icon in edit mode, instead of dragging it
         (A11Y-05). -->
    <string name="action_move_first">Move to start</string>
    <string name="action_move_earlier">Move earlier</string>
    <string name="action_move_later">Move later</string>
    <string name="action_move_last">Move to end</string>
    <!-- Read by screen readers after a move, e.g. "Mail, place 3 of 40" (A11Y-08). %1$s is the
         app's name, %2$d its place from the start and %3$d how many places there are. -->
    <string name="app_moved">%1$s, place %2$d of %3$d</string>

    <!-- Folders in Applications (FOLD-01 to FOLD-06). A folder's name until the user gives it
         one (FOLD-03). -->
    <string name="folder">Folder</string>
    <!-- What screen readers read for a folder's icon, e.g. "Folder: Games, 3 apps" (A11Y-01).
         %1$s is its name and %2$d how many apps it holds. -->
    <plurals name="folder_description">
        <item quantity="one">Folder: %1$s, %2$d app</item>
        <item quantity="other">Folder: %1$s, %2$d apps</item>
    </plurals>
    <!-- The open folder's title for screen readers, e.g. "Folder: Games" (A11Y-08). %1$s is its
         name. -->
    <string name="folder_pane">Folder: %1$s</string>
    <!-- An item of a folder's long-press menu, and the dialog it opens (FOLD-03). -->
    <string name="menu_rename_folder">Rename folder</string>
    <string name="folder_name">Folder name</string>
    <!-- Screen-reader actions in edit mode that make a folder of an app and the next one, or put
         it into the next folder, instead of dragging (A11Y-05). %1$s is the next cell's name. -->
    <string name="action_make_folder">Make folder with %1$s</string>
    <string name="action_move_into">Move into %1$s</string>
    <!-- A screen-reader action on an app in an open folder in edit mode (A11Y-05). -->
    <string name="action_move_out">Move out of folder</string>
    <!-- Read by screen readers after those actions (A11Y-08). %1$s is the app's name. -->
    <string name="app_grouped">%1$s moved into a folder</string>
    <string name="app_moved_out">%1$s moved out of the folder</string>

    <!-- App search in Applications (SRCH-01 to SRCH-05). The field's hint, and the
         screen-reader action and pane title that open it without pulling it down (A11Y-05). -->
    <string name="search_hint">Search apps</string>
    <string name="search_action">Search apps</string>
    <!-- Shown, and read by screen readers, when no app's name matches what was typed
         (SRCH-05). -->
    <string name="search_none">No apps found</string>
    <!-- Offered when no app matches: searches the web with the device's default search app
         (SRCH-05). %1$s is what was typed, e.g. "Search the web for “zebra”". -->
    <string name="search_web">Search the web for “%1$s”</string>
    <!-- Shown briefly when nothing on the device can search the web (SRCH-05). -->
    <string name="web_search_unavailable">Web search isn\'t available</string>

    <!-- Settings' title (SET-01). -->
    <string name="settings_title">Launcher settings</string>
    <!-- The Applications group of Settings (SET-02). -->
    <string name="settings_group_applications">Applications</string>
    <!-- Settings → Applications → Hidden apps: the apps hidden from their long-press menu,
         each with a button that shows it again in Applications (APPS-19). -->
    <string name="hidden_apps">Hidden apps</string>
    <string name="hidden_apps_none">No hidden apps</string>
    <string name="hidden_app_unhide">Unhide</string>
    <!-- What screen readers read for that button, e.g. "Unhide Maps" (A11Y-01). %1$s is the
         app's name, with "work" when it has it. -->
    <string name="action_unhide">Unhide %1$s</string>

    <!-- The Recent group of Settings (SET-02). -->
    <string name="settings_group_recent">Recent</string>
    <!-- Settings → Recent → Time window: how far back Recent looks for recently used apps
         (REC-11). Its three choices follow. -->
    <string name="recent_time_window">Time window</string>
    <string name="recent_window_12_hours">12 hours</string>
    <string name="recent_window_24_hours">24 hours</string>
    <string name="recent_window_3_days">3 days</string>

    <!-- The Events header's alarm row: when the next alarm rings, e.g. "Alarm 07:00", or
         "Alarm Wed 07:00" when it is more than a day away (EVT-02). %1$s is the time, in the
         device's 12- or 24-hour setting. Tapping it opens the app that set the alarm. -->
    <string name="events_alarm">Alarm %1$s</string>
    <!-- What screen readers say a tap on the alarm row does (A11Y-01). -->
    <string name="action_open_alarm">Open alarm</string>
    <!-- Shown briefly when neither the app that set the alarm nor a clock app could open
         (EVT-02). -->
    <string name="alarm_unavailable">The alarm can\'t open right now</string>

    <!-- Events' card while MeeGone has no notification access: one plain sentence saying what
         is read and why (EVT-03, ONB-02), and the button that opens the system's
         notification-access screen. -->
    <string name="events_access_explainer">MeeGone reads your notifications only to list them here, and they never leave this phone.</string>
    <string name="events_access_allow">Allow</string>
    <!-- Shown briefly when no system screen for notification access could open (EVT-03). -->
    <string name="notification_access_unavailable">Notification access can\'t open right now</string>
    <!-- The heading over Events' notifications, drawn in capitals (EVT-04, SRS 5.2). -->
    <string name="events_notifications">Notifications</string>
    <!-- Events with nothing to show (EVT-11). -->
    <string name="events_empty">No new events</string>
    <!-- A group's newest notification, its title then its text, e.g. "Anna: See you at
         eight" (EVT-04). Shown in at most two lines. -->
    <string name="events_title_text">%1$s: %2$s</string>
    <!-- What screen readers read for one app's group of notifications (EVT-04, A11Y-01), e.g.
         "Messages, 3 notifications: Anna, See you at eight". %1$s is the app's name, with
         "work" when it has it; %2$d how many it holds; %3$s the newest one's title and text. -->
    <plurals name="events_group_description">
        <item quantity="one">%1$s, %2$d notification: %3$s</item>
        <item quantity="other">%1$s, %2$d notifications: %3$s</item>
    </plurals>
    <!-- What screen readers read for an expanded group's row, whose notifications show below
         it (EVT-06, A11Y-01), e.g. "Messages, 3 notifications". %1$s is the app's name, with
         "work" when it has it; %2$d how many it holds. -->
    <plurals name="events_group_expanded_description">
        <item quantity="one">%1$s, %2$d notification</item>
        <item quantity="other">%1$s, %2$d notifications</item>
    </plurals>
    <!-- Whether a group of several shows its notifications, as screen readers say it (EVT-06,
         A11Y-01). -->
    <string name="events_expanded">Expanded</string>
    <string name="events_collapsed">Collapsed</string>
    <!-- What screen readers say a tap on a row does (A11Y-01): open the notification, or show
         or hide a group's notifications (EVT-06). -->
    <string name="action_open_notification">Open</string>
    <string name="action_expand">Expand</string>
    <string name="action_collapse">Collapse</string>
    <!-- The button at the end of the Notifications section header, which removes every
         notification that can be cleared (EVT-07), and what screen readers read for it. -->
    <string name="events_clear">Clear</string>
    <string name="events_clear_description">Clear all notifications</string>
    <!-- A notification's or a group's long-press menu (EVT-08): its pane title when it opens
         without a row to name, and its items. -->
    <string name="notification_menu">Notification menu</string>
    <string name="menu_dismiss">Dismiss</string>
    <string name="menu_notification_settings">Notification settings</string>
    <!-- Shown briefly when neither a notification nor its app could open (EVT-06). -->
    <string name="notification_unavailable">This notification can\'t open right now</string>
    <!-- Shown briefly when the system refused to remove notifications (EVT-07, EVT-08). -->
    <string name="notifications_dismiss_unavailable">Notifications can\'t be cleared right now</string>
    <!-- Shown briefly when neither an app's notification settings nor its App info could open
         (EVT-08). -->
    <string name="notification_settings_unavailable">Notification settings can\'t open right now</string>
    <!-- MeeGone's notification listener, as the system's notification-access screen names it
         (EVT-03). -->
    <string name="notification_listener_label">MeeGone Events</string>

    <!-- The heading over Events' card with today's lock-screen image, drawn in capitals, and
         the name of the image details screen it opens (EVT-12, WALL-15). -->
    <string name="image_of_the_day">Image of the day</string>
    <!-- What screen readers say a tap on that card does (A11Y-01). -->
    <string name="action_image_details">Show image details</string>
    <!-- Settings → Lock-screen image: the switch that hides or shows the card in Events
         (EVT-12, SET-02). -->
    <string name="show_image_card">Show card in Events</string>
    <!-- Settings → Lock-screen image: the switch that lets the daily image download over mobile
         data (WALL-04, SET-02). Off, it waits for Wi-Fi or another unmetered network. -->
    <string name="use_mobile_data">Use mobile data</string>
    <!-- Settings → Lock-screen image, after three days in which every check failed (SRS 7.6),
         with the button that checks again. -->
    <string name="image_unavailable">Daily image unavailable</string>
    <string name="image_try_again">Try again</string>
    <!-- What Settings says when the system can't schedule the daily image's check (SRS 8.1). -->
    <string name="image_job_unavailable">Background work isn\'t available. The image is checked when MeeGone starts.</string>
    <!-- Settings → Lock-screen image: the switch that puts Bing's image of the day on the lock
         screen. Turning it on is the user's confirmation: nothing changes before (WALL-01,
         WALL-02, SET-02). -->
    <string name="daily_image">Daily lock-screen image</string>
    <!-- Below that switch, disabled, when the device can't set wallpapers (WALL-13). -->
    <string name="wallpaper_not_supported">This device doesn\'t support wallpapers.</string>
    <string name="wallpaper_not_allowed">This device\'s policy doesn\'t allow changing the wallpaper.</string>
    <!-- Settings → Lock-screen image: fetches today's image at once, over any connection, and
         what it reads while it does (WALL-11). -->
    <string name="image_update_now">Update now</string>
    <string name="image_updating">Updating…</string>
    <!-- Settings → Lock-screen image, when another app or the system's settings changed the
         lock screen's wallpaper after MeeGone set it, with the button that puts the image back
         and goes on (WALL-14). -->
    <string name="image_paused">The lock screen\'s wallpaper was changed. Daily images are paused.</string>
    <string name="image_resume">Resume</string>
    <!-- Settings → Lock-screen image, when the device kept another wallpaper on its lock screen
         right after MeeGone set the image (SRS C5). -->
    <string name="image_may_not_show">This device may not show the image on its lock screen.</string>
    <!-- Settings → Lock-screen image, once the daily image is off: the lock screen keeps the
         last image until the user resets it, or picks another wallpaper (WALL-12). -->
    <string name="reset_lock_screen">Reset lock screen to home wallpaper</string>
    <string name="wallpaper_settings">Wallpaper settings</string>
    <!-- Shown briefly once the lock screen shows the home wallpaper again (WALL-12). -->
    <string name="lock_screen_reset">The lock screen shows the home wallpaper</string>
    <string name="lock_screen_reset_failed">The lock screen couldn\'t be reset.</string>
    <!-- Written instructions when the system has no wallpaper settings to open (SRS 8.1). -->
    <string name="wallpaper_settings_unavailable">To change the wallpaper, open Settings, then Wallpaper.</string>
    <!-- Settings → Lock-screen image and the image details screen: when MeeGone last put an
         image on the lock screen (WALL-16). %1$s is the date and time, such as
         "19 November, 07:00". -->
    <string name="image_last_updated">Last updated %1$s</string>
    <!-- The same line before the first image is on the lock screen (WALL-16). -->
    <string name="image_not_updated_yet">Not updated yet</string>
    <!-- Below it while the daily check fails and will run again (WALL-16, REL-04). %1$s is the
         problem in plain words, such as "No connection". -->
    <string name="image_will_try_again">%1$s. Will try again later.</string>
    <!-- Below "Daily image unavailable": the problem that made it so (SRS 7.6). %1$s is the
         problem in plain words. -->
    <string name="image_last_problem">%1$s.</string>
    <!-- The image details screen: the image's date and the feed region it is from (WALL-15).
         %1$s is the date, such as "15 November"; %2$s the region, such as
         "English (United Kingdom)". -->
    <string name="image_date_region">%1$s · %2$s</string>
    <!-- The image details screen: opens the image source's page about the image in the browser
         (WALL-15). Hidden when there is no page or no browser. -->
    <string name="image_more_info">More info</string>
    <!-- The image details screen: opens Settings at its Lock-screen image group (WALL-15). -->
    <string name="image_open_settings">Settings</string>
    <!-- Shown briefly when no browser could open a link (SEC-02, SRS 8.1). -->
    <string name="browser_unavailable">No browser can open this link</string>
    <!-- Recent's card while MeeGone has no usage access: one plain sentence saying what is
         read and why (REC-02, ONB-02), and the button that opens the system's usage-access
         screen. -->
    <string name="recent_access_explainer">MeeGone reads which apps you used recently only to show them here, and that never leaves this phone.</string>
    <string name="recent_access_allow">Allow</string>
    <!-- Shown briefly when no system screen for usage access could open (REC-02). -->
    <string name="usage_access_unavailable">Usage access can\'t open right now</string>
    <!-- Recent with usage access and no app used lately (REC-10). -->
    <string name="recent_empty">No recent apps</string>
    <!-- How long ago an app was last used, below its label on its Recent card (REC-04). It
         never says the app is running or closed (REC-01). %d is how many minutes, hours or
         days. -->
    <string name="recent_just_now">Just now</string>
    <plurals name="recent_minutes_ago">
        <item quantity="one">%d min ago</item>
        <item quantity="other">%d min ago</item>
    </plurals>
    <plurals name="recent_hours_ago">
        <item quantity="one">%d h ago</item>
        <item quantity="other">%d h ago</item>
    </plurals>
    <plurals name="recent_days_ago">
        <item quantity="one">%d d ago</item>
        <item quantity="other">%d d ago</item>
    </plurals>
    <!-- The same in words, for screen readers (A11Y-01). -->
    <plurals name="recent_minutes_ago_spoken">
        <item quantity="one">%d minute ago</item>
        <item quantity="other">%d minutes ago</item>
    </plurals>
    <plurals name="recent_hours_ago_spoken">
        <item quantity="one">%d hour ago</item>
        <item quantity="other">%d hours ago</item>
    </plurals>
    <plurals name="recent_days_ago_spoken">
        <item quantity="one">%d day ago</item>
        <item quantity="other">%d days ago</item>
    </plurals>
    <!-- What screen readers read for a Recent card (REC-04, A11Y-01), e.g. "Mail, work, 5
         minutes ago". %1$s is the app's name, with "work" when it has it; %2$s how long ago it
         was used. -->
    <string name="recent_card_description">%1$s, %2$s</string>
    <!-- What screen readers say a tap on a Recent card does (REC-06, A11Y-01). -->
    <string name="action_open_app">Open</string>
    <!-- Screen-reader actions that switch Recent between two cards to a row and three, as a
         pinch does (REC-05, A11Y-05). Also read out once the cards have changed. -->
    <string name="action_bigger_cards">Bigger cards</string>
    <string name="action_more_cards">More cards</string>
    <!-- Recent's close mode (REC-07): the button at the end of the Recent section header that
         removes every card from Recent, and what screen readers read for it. It never says
         apps are closed (REC-01, REC-08). -->
    <string name="recent_clear_all">Clear all</string>
    <string name="recent_clear_all_description">Remove all apps from Recent</string>
    <!-- Shown briefly once cards are removed from Recent by their ✕ or Clear all (REC-08). The
         apps keep running. -->
    <string name="recent_removed">Removed from Recent</string>
    <!-- Read by screen readers once one card is removed from Recent (A11Y-08). %1$s is the
         app's name. -->
    <string name="recent_removed_app">%1$s removed from Recent</string>
    <!-- Read by screen readers when close mode starts (A11Y-08). -->
    <string name="recent_close_mode">Editing Recent</string>
    <!-- The screen-reader action that enters close mode, as a long-press on Recent's cards does
         (REC-07, A11Y-05). -->
    <string name="action_edit_recent">Edit Recent</string>
    <!-- The name of a card's ✕ in close mode, which removes it from Recent (REC-08, A11Y-01).
         Screen readers offer it as an action. %1$s is the app's name. -->
    <string name="action_remove_from_recent">Remove %1$s from Recent</string>
</resources>
