<?xml version="1.0" encoding="utf-8"?>
<!-- MeeGone asks only for the access listed in SRS 8.1 (SEC-03). Being the home app is a role
     the user grants in the system dialog (HOME-01). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uninstall requests (APPS-13, ADR 0013): from Android 9 the system's uninstall
         confirmation refuses apps without it. Granted at install, with no prompt; the system
         still asks the user to confirm every uninstall. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Usage access for Recent (REC-02, REC-03, ADR 0023), one of the two optional special
         accesses in SRS 8.1. Declaring it only lists MeeGone on the system's usage-access
         screen: the user grants it there, and Recent explains what it reads first (ONB-02). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Network and network state (SRS 8.1), granted at install, for the daily image: its one
         destination is the image feed (PRIV-02, ADR 0027). Only HTTPS is allowed, as
         network_security_config.xml says (SEC-01). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Setting the wallpaper (SRS 8.1), granted at install, for the daily image: MeeGone sets
         only the lock screen's wallpaper, and never replaces or covers the lock screen itself
         (WALL-01, SEC-05, ADR 0030). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Applications lists every app with a launcher entry (APPS-01), and the first grid puts
         the default browser and camera first (APPS-05). From Android 11, other apps are hidden
         from MeeGone unless it declares them here. It is not a permission (SEC-03). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <!-- The system's backup and device-to-device transfer keep the layout and the settings, and
         nothing else (APPS-21, ADR 0018): backup_rules.xml up to Android 11,
         data_extraction_rules.xml from Android 12. Back reaches the home through
         OnBackInvokedCallback from Android 13 (HOME-08, ADR 0007). The network security config
         refuses cleartext traffic and trusts only the system's certificates (SEC-01,
         ADR 0027). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeeGone">

        <!-- The home screen. singleTask keeps one home task; a Home press while it shows reaches
             onNewIntent. Configuration changes that resize, rotate, fold or unfold are handled
             in place, and so is the device's dark theme, which the System theme follows with a
             cross-fade (THEME-02, THEME-06, ADR 0033); any other, such as a new density,
             recreates the activity, and the shared launcher keeps all state (COMP-03,
             ADR 0009). The orientation follows the screen's
             size at run time (HOME-12). adjustResize hands the keyboard's height to HomeViews as
             an inset, which only search's results take (ADR 0016); edge to edge, the window
             itself never resizes. -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">

            <!-- A home app: offered in the system's home-app choice (HOME-01). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- And a normal app, so it runs without the role. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The system's settings entry for MeeGone, such as the gear beside it in Default
                 apps → Home app: it opens MeeGone's Settings (SET-01, SEC-04, ADR 0035). -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Events' notifications (EVT-04, ADR 0020). The system binds the listener only while
             the user grants notification access in its settings (EVT-03), and only the system
             can, as it alone holds BIND_NOTIFICATION_LISTENER_SERVICE. It must be exported for
             that, as SEC-04 allows. -->
        <service
            android:name=".NotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The daily image's check, MeeGone's one scheduled job (ARCH-07, ADR 0029). Only the
             system's job scheduler may start it. -->
        <service
            android:name=".ImageJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
