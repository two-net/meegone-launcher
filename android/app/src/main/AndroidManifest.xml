<?xml version="1.0" encoding="utf-8"?>
<!-- MeeGone asks only for the access listed in SRS 8.1 (SEC-03). Being the home app is a role
     the user grants in the system dialog (HOME-01). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Uninstall requests (APPS-13, ADR 0013): from Android 9 the system's uninstall
         confirmation refuses apps without it. Granted at install, with no prompt; the system
         still asks the user to confirm every uninstall. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Applications lists every app with a launcher entry (APPS-01), and the first grid puts
         the default browser and camera first (APPS-05). From Android 11, other apps are hidden
         from MeeGone unless it declares them here. It is not a permission (SEC-03). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <!-- Backup arrives with APPS-21 (#17). Back reaches the home through
         OnBackInvokedCallback from Android 13 (HOME-08, ADR 0007). -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeeGone">

        <!-- The home screen. singleTask keeps one home task; a Home press while it shows reaches
             onNewIntent. Configuration changes that resize, rotate, fold or unfold are handled
             in place; any other, such as a new density, recreates the activity, and the shared
             launcher keeps all state (COMP-03, ADR 0009). The orientation follows the screen's
             size at run time (HOME-12). adjustResize hands the keyboard's height to HomeViews as
             an inset, which only search's results take (ADR 0016); edge to edge, the window
             itself never resizes. -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">

            <!-- A home app: offered in the system's home-app choice (HOME-01). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- And a normal app, so it runs without the role. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
